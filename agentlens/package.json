{
  "name": "agentlens",
  "displayName": "AgentLens",
  "description": "Real-time AI Agent monitor — task progress, tool feed, and watchdog alerts for Claude Code, Codex, Roo Code, and Cursor sessions.",
  "version": "1.1.2",
  "publisher": "agentlens",
  "repository": {
    "type": "git",
    "url": "https://github.com/yann4030/agentlens"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onView:agentlens.sidebar",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentlens",
          "title": "AgentLens",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentlens": [
        {
          "id": "agentlens.sidebar",
          "name": "Agent Monitor",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "agentlens.refresh",
        "title": "AgentLens: Refresh View"
      },
      {
        "command": "agentlens.clearHistory",
        "title": "AgentLens: Clear History"
      },
      {
        "command": "agentlens.switchSession",
        "title": "AgentLens: Switch Session"
      },
      {
        "command": "agentlens.reset",
        "title": "AgentLens: Full Reset"
      }
    ],
    "configuration": {
      "title": "AgentLens",
      "properties": {
        "agentlens.idleTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "description": "Seconds without file writes before session is marked Done."
        },
        "agentlens.activeToolTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "description": "Seconds a tool can run without new output before session is marked Interrupted."
        },
        "agentlens.staleFileTimeoutSeconds": {
          "type": "number",
          "default": 300,
          "description": "Seconds without file writes before session is considered completely stale and all tasks are auto-completed."
        },
        "agentlens.staleTodoWriteSeconds": {
          "type": "number",
          "default": 120,
          "description": "Seconds since last TodoWrite before old tasks are cleared at startup."
        },
        "agentlens.pollIntervalMs": {
          "type": "number",
          "default": 5000,
          "description": "How often (ms) the activity monitor checks the session file."
        },
        "agentlens.watchdogNotificationsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show VS Code popup notifications when watchdog alerts fire."
        },
        "agentlens.loopDetectionEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Detect tool-call loops (4 identical calls or alternating patterns)."
        },
        "agentlens.retryScanIntervalMs": {
          "type": "number",
          "default": 10000,
          "description": "When no session is found, how often (ms) to rescan for new Claude Code sessions."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "webpack --mode production",
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "npx vsce package",
    "lint": "eslint src --ext ts,tsx"
  },
  "devDependencies": {
    "@types/chokidar": "^1.7.5",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.2",
    "css-loader": "^6.9.1",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
